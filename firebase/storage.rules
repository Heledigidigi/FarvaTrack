rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && fileName == request.auth.uid + '.jpg';
    }

    // MARK: Sticker kütüphanesi (Aşama 8D)
    // users/{uid}/stickers/{id}.png: yalnızca sahibi; şeffaf PNG, en fazla 2 MB (512×512 çıktı).
    match /users/{userId}/stickers/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && fileName.matches('[A-Za-z0-9-]+[.]png')
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType == 'image/png';
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // MARK: Baloncuk stilleri (Aşama 8F)
    // users/{uid}/bubbles/{styleId}/{assetId}.png: sahibi yazar; sohbet arkadaşı okuyabilir.
    function sharesChatWith(otherId) {
      let me = request.auth.uid;
      let chatId = me < otherId ? me + '_' + otherId : otherId + '_' + me;
      return firestore.exists(/databases/(default)/documents/chats/$(chatId));
    }

    match /users/{userId}/bubbles/{styleId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == userId || sharesChatWith(userId));
      allow create, update: if request.auth != null && request.auth.uid == userId
        && fileName.matches('[A-Za-z0-9-]+[.]png')
        && request.resource.size < 1024 * 1024
        && request.resource.contentType == 'image/png';
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // MARK: Sohbet medyası (Aşama 8B)
    // chats/{chatId}/media/{messageId}/thumb.jpg, original.<uzantı> ve voice.m4a (8C)
    // Üyelik Firestore'daki sohbet belgesinden okunur (konsol, Storage'ın Firestore'a erişim iznini ister).
    function chatMembers(chatId) {
      return firestore.get(/databases/(default)/documents/chats/$(chatId)).data.members;
    }

    function isChatMember(chatId) {
      return request.auth != null && request.auth.uid in chatMembers(chatId);
    }

    match /chats/{chatId}/media/{messageId}/{fileName} {
      allow read: if isChatMember(chatId);

      // Yükleyen gönderen olmalı (metadata.senderId), yalnızca önizleme ve orijinal adları,
      // önizleme en fazla 2 MB JPEG, orijinal en fazla 2 GB fotoğraf/video.
      allow create: if isChatMember(chatId)
        && request.resource.metadata.senderId == request.auth.uid
        && (
          (fileName == 'thumb.jpg'
            && request.resource.size < 2 * 1024 * 1024
            && request.resource.contentType == 'image/jpeg')
          ||
          (fileName.matches('original[.][a-z0-9]{2,5}')
            && request.resource.size < 2 * 1024 * 1024 * 1024
            && request.resource.contentType.matches('(image|video)/.+'))
          ||
          // Sticker mesajı ve sohbet üstü yerleştirme (8E): şeffaf PNG, en fazla 2 MB.
          (fileName == 'sticker.png'
            && request.resource.size < 2 * 1024 * 1024
            && request.resource.contentType == 'image/png')
          ||
          // Sesli mesaj (8C): AAC .m4a, en fazla 50 MB.
          (fileName == 'voice.m4a'
            && request.resource.size < 50 * 1024 * 1024
            && request.resource.contentType.matches('audio/(mp4|aac|x-m4a|m4a)'))
        );

      // Yarıda kalıp baştan yüklenen dosya: yalnızca ilk yükleyen üzerine yazabilir.
      allow update: if isChatMember(chatId)
        && resource.metadata.senderId == request.auth.uid
        && request.resource.metadata.senderId == request.auth.uid
        && request.resource.size < 2 * 1024 * 1024 * 1024;

      // "Herkesten sil" ve hesap silme temizliği.
      allow delete: if isChatMember(chatId);
    }
  }
}
