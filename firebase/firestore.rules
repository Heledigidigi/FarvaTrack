rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // İstek sahibi ile `otherId` arasında sohbet odası var mı (oda kimliği: küçük uid _ büyük uid).
    function sharesChatWith(otherId) {
      let me = request.auth.uid;
      let chatId = me < otherId ? me + '_' + otherId : otherId + '_' + me;
      return signedIn() && exists(/databases/$(database)/documents/chats/$(chatId));
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    match /users/{userId} {
      // Yönetici, biyolojik atık özetinde kullanıcı adlarını listeleyebilsin diye profilleri okuyabilir.
      allow read: if isOwner(userId) || isAdmin();

      // Profil ilk oluşurken role alanı bulunamaz.
      allow create: if isOwner(userId) && !('role' in request.resource.data);

      // Güncellemede role alanı aynı kalmalı: istemci kendini admin yapamaz.
      allow update: if isOwner(userId)
        && request.resource.data.get('role', null) == resource.data.get('role', null);

      allow delete: if isOwner(userId);

      match /workouts/{id}     { allow read, write: if isOwner(userId); }
      match /meals/{id}        { allow read, write: if isOwner(userId); }
      match /water/{id}        { allow read, write: if isOwner(userId); }
      match /sleep/{id}        { allow read, write: if isOwner(userId); }
      match /weight/{id}       { allow read, write: if isOwner(userId); }
      match /measurements/{id} { allow read, write: if isOwner(userId); }
      match /library/{id}      { allow read, write: if isOwner(userId); }
      match /templates/{id}    { allow read, write: if isOwner(userId); }
      match /programs/{id}     { allow read, write: if isOwner(userId); }
      match /manualSteps/{id}  { allow read, write: if isOwner(userId); }
      // Kişisel sticker kütüphanesi (8D): yalnızca sahibi.
      match /stickers/{id}     { allow read, write: if isOwner(userId); }
      // Push bildirimi cihazları (8G): yalnızca sahibi. Bildirimi medya sunucusu servis hesabıyla okur.
      match /devices/{deviceId} {
        allow read, delete: if isOwner(userId);
        allow write: if isOwner(userId)
          && deviceId.matches('^[A-Za-z0-9-]{1,64}$')
          && request.resource.data.keys().hasOnly(['token', 'platform', 'muted', 'appVersion', 'voipToken', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() < 4096
          && request.resource.data.muted is bool;
      }
      // Baloncuk stilleri (8F): sahibi yazar; sohbet arkadaşı (aralarında sohbet odası olan) okuyabilir.
      match /bubbles/{id} {
        allow read: if isOwner(userId) || sharesChatWith(userId);
        allow write: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['json', 'version', 'updatedAt'])
          && request.resource.data.json is string
          && request.resource.data.json.size() < 20000
          && request.resource.data.version is int;
        allow delete: if isOwner(userId);
      }

      // Biyolojik atık: tek tek kayıtlar (saatleriyle) yalnızca sahibine açıktır.
      match /waste/{id}        { allow read, write: if isOwner(userId); }

      // Günlük toplamlar: sahibi yazar, yönetici yalnızca okur.
      match /wasteDaily/{day}  {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
    }

    // MARK: Sohbet (Aşama 8A)
    // İki kişilik özel sohbet. Oda kimliği iki uid'nin sıralı birleşimidir: "<küçük>_<büyük>".

    function chatDoc(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId));
    }

    function isChatMember(chatId) {
      return signedIn() && request.auth.uid in chatDoc(chatId).data.members;
    }

    // Fotoğraf/video mesajı: medya bilgisi bu mesajın Storage klasörünü göstermeli (8B).
    // Sesli mesaj: ses dosyası aynı klasörde `voice.m4a` (8C).
    // Diğer türlerde bu alanlar olmaz.
    function validMedia(chatId, messageId, data) {
      let folder = 'chats/' + chatId + '/media/' + messageId + '/';
      let mediaOk = data.type in ['image', 'video']
        ? (data.media is map
            && data.media.thumbnailPath == folder + 'thumb.jpg'
            && data.media.originalPath.matches(folder + 'original[.][a-z0-9]{2,5}')
            && data.media.status in ['uploading', 'ready']
            && data.media.size is int)
        : !('media' in data);
      let audioOk = data.type == 'audio'
        ? (data.audio is map
            && data.audio.path == folder + 'voice.m4a'
            && data.audio.duration is number
            && data.audio.duration <= 1800
            && data.audio.waveform is list
            && data.audio.waveform.size() <= 128)
        : !('audio' in data);
      let stickerOk = data.type == 'sticker'
        ? (data.sticker is map && data.sticker.path == folder + 'sticker.png')
        : !('sticker' in data);
      // Arama satırı (8H): sonuç ve süre.
      // Diyet programı kartı (Aşama 9): teklif belgesine başvurur.
      let dietOk = data.type == 'diet'
        ? (data.diet is map
            && data.diet.offerId is string
            && data.diet.offerId.size() <= 64
            && data.diet.name is string
            && data.diet.name.size() <= 80)
        : !('diet' in data);
      let callOk = data.type == 'call'
        ? (data.call is map
            && data.call.keys().hasOnly(['callId', 'outcome', 'duration'])
            && data.call.callId is string
            && data.call.outcome in ['answered', 'missed', 'declined', 'busy', 'failed']
            && data.call.duration is number
            && data.call.duration >= 0)
        : !('call' in data);
      return mediaOk && audioOk && stickerOk && callOk && dietOk;
    }

    // Sohbet üstüne bırakılan sticker (8E): konum en yakın mesaja bağlı; dosya bu yerleştirmenin klasöründe.
    function validPlacement(chatId, placementId, data) {
      return data.keys().hasOnly(['senderId', 'anchorMessageId', 'x', 'y', 'scale', 'rotation', 'z', 'sticker', 'createdAt', 'updatedAt'])
        && data.senderId == request.auth.uid
        && data.anchorMessageId is string
        && data.x is number && data.x >= 0 && data.x <= 1
        && data.y is number && data.y >= -5000 && data.y <= 5000
        && data.scale is number && data.scale >= 0.3 && data.scale <= 3
        && data.rotation is number
        && data.z is number
        && data.sticker is map
        && data.sticker.path == 'chats/' + chatId + '/media/' + placementId + '/sticker.png'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Değişen alanlar yalnızca `keys` içinden olabilir.
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Kullanıcı adları: herkes arayabilir (giriş yapmış); yalnızca sahibi alır, günceller, bırakır.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && name.matches('^[a-z0-9._]{3,20}$')
        && (resource == null || resource.data.uid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && (!('photoURL' in request.resource.data) || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() < 1024));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Arkadaşlık istekleri: `{gönderen}_{alan}`. Yalnızca iki taraf görür; gönderen oluşturur,
    // iki taraf da siler (reddet / geri çek / kabul sonrası).
    match /friendRequests/{requestId} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'fromUsername', 'fromPhoto', 'toName', 'toUsername', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && requestId == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 100
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 100
        && request.resource.data.fromUsername is string && request.resource.data.fromUsername.size() <= 20
        && request.resource.data.toUsername is string && request.resource.data.toUsername.size() <= 20
        && request.resource.data.createdAt is timestamp;
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Davet kodları: kodu bilen okuyabilir (listeleyemez), yalnızca bir kez ve başkası kullanabilir.
    match /chatInvites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['ownerId', 'ownerName', 'createdAt', 'expiresAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 100
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h');

      // Kullanma: süresi dolmamış, henüz kullanılmamış kodun yalnızca `redeemedBy` alanını kullanan kendisi yapar.
      // Sahibi kendi kodunu kullanırsa kendine not sohbeti açılır.
      allow update: if signedIn()
        && resource.data.get('redeemedBy', null) == null
        && resource.data.expiresAt > request.time
        && onlyChanges(['redeemedBy'])
        && request.resource.data.redeemedBy == request.auth.uid;

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /chats/{chatId} {
      // Sorgu (members array-contains uid) da bu kuralla sınırlanır: yalnızca üyeler görür.
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // Oda üç yoldan açılır:
      //  1) Arkadaşlık isteği: isteği alan kişi kabul eder; istek aynı toplu yazımda silinir (`get` önceki hali okur).
      //  2) Kendime not: iki üye de kendisi.
      //  3) Eski davet kodu: kod aynı toplu yazımda kullanılır.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'names', 'createdAt', 'inviteCode', 'friendRequest', 'typing', 'lastMessage', 'photos', 'presence'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        // Karşılıklı sohbet (küçük uid önce) ya da kendine not sohbeti (iki üye de kendisi).
        && (request.resource.data.members[0] < request.resource.data.members[1]
            || (request.resource.data.members[0] == request.auth.uid && request.resource.data.members[1] == request.auth.uid))
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && (
          (request.resource.data.get('friendRequest', null) is string
            && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.friendRequest))
            && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.friendRequest)).data.to == request.auth.uid
            && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.friendRequest)).data.from in request.resource.data.members)
          || (request.resource.data.members[0] == request.auth.uid && request.resource.data.members[1] == request.auth.uid
              && !('inviteCode' in request.resource.data) && !('friendRequest' in request.resource.data))
          || (request.resource.data.get('inviteCode', null) is string
              && getAfter(/databases/$(database)/documents/chatInvites/$(request.resource.data.inviteCode)).data.redeemedBy == request.auth.uid
              && getAfter(/databases/$(database)/documents/chatInvites/$(request.resource.data.inviteCode)).data.ownerId in request.resource.data.members)
        );

      // Üyeler değişmez; yalnızca son mesaj ve kendi "yazıyor", profil fotoğrafı ve çevrimiçi alanları güncellenir.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && onlyChanges(['lastMessage', 'typing', 'photos', 'presence'])
        && request.resource.data.get('typing', {}).diff(resource.data.get('typing', {})).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('photos', {}).diff(resource.data.get('photos', {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.get('photos', {}))
            || (request.resource.data.photos[request.auth.uid] is string
                && request.resource.data.photos[request.auth.uid].size() < 1024))
        && request.resource.data.get('presence', {}).diff(resource.data.get('presence', {})).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.get('presence', {}))
            || (request.resource.data.presence[request.auth.uid].keys().hasOnly(['online', 'at'])
                && request.resource.data.presence[request.auth.uid].online is bool
                && request.resource.data.presence[request.auth.uid].at is timestamp))
        && (!('lastMessage' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.lastMessage.senderId == request.auth.uid);

      // Hesap silinirken oda kaldırılır.
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read: if isChatMember(chatId);

        allow create: if isChatMember(chatId)
          && request.resource.data.keys().hasOnly(['senderId', 'type', 'text', 'createdAt', 'replyTo', 'deleted', 'media', 'audio', 'sticker', 'bubble', 'call', 'diet'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ['text', 'image', 'video', 'audio', 'sticker', 'call', 'diet']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt is timestamp
          && request.resource.data.deleted == false
          && validMedia(chatId, messageId, request.resource.data)
          // Baloncuk başvurusu (8F): stil gönderenindir, `users/{senderId}/bubbles/{id}`.
          && (!('bubble' in request.resource.data)
              || (request.resource.data.bubble is map
                  && request.resource.data.bubble.keys().hasOnly(['id', 'version'])
                  && request.resource.data.bubble.id is string
                  && request.resource.data.bubble.id.size() <= 64
                  && request.resource.data.bubble.version is int));

        // Gönderen: metni düzenler ya da herkesten siler (silinmiş mesaj bir daha değişmez).
        // Alıcı: yalnızca bir kez okundu bilgisini yazar.
        // Her üye: yalnızca kendi tepkisini ekler/kaldırır.
        allow update: if isChatMember(chatId) && (
          (resource.data.senderId == request.auth.uid
            && resource.data.deleted == false
            && onlyChanges(['text', 'editedAt', 'deleted', 'media', 'audio', 'sticker'])
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 4000
            && (request.resource.data.deleted == true || validMedia(chatId, messageId, request.resource.data)))
          ||
          (resource.data.senderId != request.auth.uid
            && resource.data.get('readAt', null) == null
            && onlyChanges(['readAt'])
            && request.resource.data.readAt is timestamp)
          ||
          // Alıcı: mesaj cihazına ulaştı (bir kez).
          (resource.data.senderId != request.auth.uid
            && resource.data.get('deliveredAt', null) == null
            && onlyChanges(['deliveredAt'])
            && request.resource.data.deliveredAt is timestamp)
          ||
          // Alıcı: sesli mesajı bir kez "dinlendi" işaretler.
          (resource.data.senderId != request.auth.uid
            && resource.data.type == 'audio'
            && resource.data.get('listenedAt', null) == null
            && onlyChanges(['listenedAt'])
            && request.resource.data.listenedAt is timestamp)
          ||
          (onlyChanges(['reactions'])
            && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
            && (!(request.auth.uid in request.resource.data.get('reactions', {}))
                || (request.resource.data.reactions[request.auth.uid] is string
                    && request.resource.data.reactions[request.auth.uid].size() <= 16)))
        );

        // Kalıcı silme yalnızca hesap silme temizliği içindir; arayüz "herkesten sil" için `deleted` alanını kullanır.
        allow delete: if isChatMember(chatId);
      }

      // Serbest yerleştirmeler: iki üye görür; yalnızca yerleştiren taşır ve siler.
      match /placements/{placementId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId) && validPlacement(chatId, placementId, request.resource.data);
        allow update: if isChatMember(chatId)
          && resource.data.senderId == request.auth.uid
          && validPlacement(chatId, placementId, request.resource.data);
        allow delete: if isChatMember(chatId) && resource.data.senderId == request.auth.uid;
      }

      // Sesli arama sinyalleşmesi (8H): teklif/yanıt SDP'leri, durum ve ICE adayları.
      // Arayan oluşturur; iki taraf da durumu ilerletir; yalnızca arayan teklif, aranan yanıt yazar.
      match /calls/{callId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.keys().hasOnly(['callerId', 'calleeId', 'status', 'offer', 'offerVersion', 'answerVersion', 'createdAt'])
          && request.resource.data.callerId == request.auth.uid
          && request.resource.data.calleeId != request.auth.uid
          && request.resource.data.calleeId in chatDoc(chatId).data.members
          && request.resource.data.status == 'ringing'
          && request.resource.data.offer is map
          && request.resource.data.offer.sdp is string
          && request.resource.data.offer.sdp.size() < 20000;
        allow update: if isChatMember(chatId)
          && request.auth.uid in [resource.data.callerId, resource.data.calleeId]
          && request.resource.data.callerId == resource.data.callerId
          && request.resource.data.calleeId == resource.data.calleeId
          && onlyChanges(['status', 'offer', 'offerVersion', 'answer', 'answerVersion', 'answeredAt', 'endedAt', 'endedBy'])
          && request.resource.data.status in ['ringing', 'accepted', 'declined', 'busy', 'missed', 'ended', 'failed']
          && (!('offer' in request.resource.data.diff(resource.data).affectedKeys()) || request.auth.uid == resource.data.callerId)
          && (!('answer' in request.resource.data.diff(resource.data).affectedKeys()) || request.auth.uid == resource.data.calleeId);
        allow delete: if isChatMember(chatId);

        match /candidates/{candidateId} {
          allow read: if isChatMember(chatId);
          allow create: if isChatMember(chatId)
            && request.resource.data.keys().hasOnly(['from', 'candidate', 'sdpMid', 'sdpMLineIndex', 'offerVersion', 'createdAt'])
            && request.resource.data.from == request.auth.uid
            && request.resource.data.candidate is string
            && request.resource.data.candidate.size() < 2000;
          allow delete: if isChatMember(chatId);
        }
      }
    }
  
    // MARK: Diyet programları (Aşama 9)
    // Program sahibinin; sahibi izin verdiği kişileri (`viewerIDs`, en çok 5) okuyucu yapar.
    // Okuyucular kayıtları, notları görür; yorum ve değişiklik önerisi bırakabilir. Yalnızca sahibi yazar.
    function dietProgram(programId) {
      return get(/databases/$(database)/documents/dietPrograms/$(programId)).data;
    }

    function ownsDiet(programId) {
      return signedIn() && dietProgram(programId).ownerID == request.auth.uid;
    }

    function canViewDiet(programId) {
      let program = dietProgram(programId);
      return signedIn() && (program.ownerID == request.auth.uid || request.auth.uid in program.get('viewerIDs', []));
    }

    match /dietPrograms/{programId} {
      allow read: if signedIn()
        && (resource.data.ownerID == request.auth.uid || request.auth.uid in resource.data.get('viewerIDs', []));
      allow create: if signedIn()
        && request.resource.data.ownerID == request.auth.uid
        && request.resource.data.id == programId
        && request.resource.data.viewerIDs is list
        && request.resource.data.viewerIDs.size() <= 5
        && !(request.auth.uid in request.resource.data.viewerIDs);
      allow update: if signedIn()
        && resource.data.ownerID == request.auth.uid
        && request.resource.data.ownerID == request.auth.uid
        && request.resource.data.id == programId
        && request.resource.data.viewerIDs is list
        && request.resource.data.viewerIDs.size() <= 5;
      allow delete: if signedIn() && resource.data.ownerID == request.auth.uid;

      match /logs/{logId} {
        allow read: if canViewDiet(programId);
        allow write: if ownsDiet(programId);
      }

      match /notes/{dayKey} {
        allow read: if canViewDiet(programId);
        allow write: if ownsDiet(programId);
      }

      match /comments/{commentId} {
        allow read: if canViewDiet(programId);
        allow create: if canViewDiet(programId)
          && request.resource.data.authorID == request.auth.uid
          && request.resource.data.programID == programId
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000;
        allow delete: if signedIn() && (resource.data.authorID == request.auth.uid || ownsDiet(programId));
      }

      match /suggestions/{suggestionId} {
        allow read: if canViewDiet(programId);
        allow create: if canViewDiet(programId)
          && request.resource.data.authorID == request.auth.uid
          && request.resource.data.programID == programId
          && request.resource.data.status == 'pending';
        allow update: if ownsDiet(programId)
          && onlyChanges(['status', 'decidedAt'])
          && request.resource.data.status in ['accepted', 'rejected'];
        allow delete: if signedIn() && (resource.data.authorID == request.auth.uid || ownsDiet(programId));
      }
    }

    // Sohbetten gönderilen program: gönderen ve alıcı okur; yalnızca alıcı kabul/ret yazar.
    match /dietOffers/{offerId} {
      allow read: if signedIn() && (resource.data.fromID == request.auth.uid || resource.data.toID == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromID == request.auth.uid
        && request.resource.data.id == offerId
        && request.resource.data.status == 'pending'
        && request.resource.data.toID is string
        && sharesChatWith(request.resource.data.toID);
      allow update: if signedIn()
        && resource.data.toID == request.auth.uid
        && onlyChanges(['status', 'acceptedProgramID', 'decidedAt'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if signedIn() && (resource.data.fromID == request.auth.uid || resource.data.toID == request.auth.uid);
    }
  }
}
